{
  "name": "gmail-mcp",
  "version": "1.0.0",
  "description": "MCP server for Gmail with full API access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "googleapis": "^140.0.0",
    "zod": "^3.23.0",
    "open": "^10.0.0",
    "nodemailer": "^6.9.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/mime-types": "^2.1.4",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
